# Copy this file to .env and fill in the key. .env is git-ignored; never put keys in config.yaml
# (it is copied verbatim into the output dataset as config.snapshot.yaml).
#
# Variables already set in your shell take precedence over this file.
# Set only ONE of ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN -- with both set, requests are rejected.

ANTHROPIC_API_KEY=
